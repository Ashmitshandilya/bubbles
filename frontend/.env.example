# Public address of the backend API (must be https in production)
NEXT_PUBLIC_API_URL=https://api.heybubbles.in
# Supabase browser credentials (publishable key only; never the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public address of this site and whether search engines may index it (leave false until launch)
NEXT_PUBLIC_SITE_URL=https://heybubbles.in
NEXT_PUBLIC_ALLOW_INDEXING=false
