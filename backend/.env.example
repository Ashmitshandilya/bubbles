# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI: keep paid routing disabled
ALLOW_PAID_AI=false
ALLOW_KEYLESS_AI=false
ALLOW_KEYLESS_HEALTH_DATA=false
# One chat reply waits at most AI_REPLY_BUDGET_S for models in total (Gemini first, then the keyed fallbacks). A single call is cut off after
# GEMINI_TIMEOUT_S (Gemini) or AI_REQUEST_TIMEOUT (the others) so a stuck provider hands over quickly. AI_MAX_OUTPUT_TOKENS caps a reply:
# keep it generous, a cut-off JSON reply is unusable.
AI_REQUEST_TIMEOUT=18
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_MS=250
AI_REPLY_BUDGET_S=50
AI_MAX_OUTPUT_TOKENS=900
# How long a chat turn waits for optional extras before replying without them (seconds)
CHAT_RAG_BUDGET_S=2.0
CHAT_CONTEXT_BUDGET_S=8.0
RAG_EMBED_TIMEOUT_S=3

# Gemini answers first. Its model is NOT checked against FREE_MODEL_ALLOWLIST (only the providers below are): use a free-tier key and a
# model you have verified as free, because nothing in the code stops a paid Gemini model from being used if you set one here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_S=9
GEMINI_THINKING_LEVEL=low

# Free-provider credentials/models (only use providers/models you have verified as free)
# Get keys from: https://console.groq.com, https://build.nvidia.com, https://console.mistral.ai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# Optional: Additional free-tier providers (only add after verifying free tier and updating allowlist in ai_provider.py)
# COHERE_API_KEY=
# INCEPTION_API_KEY=
# API_MIX_API_KEY=

# RAG
RAG_EMBED_FUNCTION=rag-embed
# Whole-Health OS
# Long random secret used to sign stored documents (set once; changing it invalidates saved plans).
BUBBLES_DOC_SIGNING_KEY=
# Set to true ONLY after a clinician has signed docs/clinical/BUBBLES_CLINICAL_REVIEW_PACKET.
BUBBLES_CLINICALLY_REVIEWED=false
# Free Open Food Facts barcode lookup (only the barcode is sent).
BUBBLES_ENABLE_OPENFOODFACTS=true

# Hosting
# Browser origins allowed to call this API (comma separated). Include your real site address.
BUBBLES_FRONTEND_ORIGINS=https://heybubbles.in,https://www.heybubbles.in
# Legacy COCO_* names still work (env_compat.py maps them), but use BUBBLES_* in new deployments.

# Phone notifications (Android app) through Firebase Cloud Messaging. Free on every Firebase plan. See docs/FIREBASE.md.
# The service-account key file from Firebase console > Project settings > Service accounts > Generate new private key,
# pasted as one line of JSON or as base64. It is a server secret: never put it in the frontend or the APK.
FIREBASE_SERVICE_ACCOUNT_JSON=
# How often the server checks for due reminders for people with phone notifications on (seconds, minimum 60).
PUSH_SWEEP_SECONDS=300
# Set to 0 to stop the background check (reminders are then created only when the app is opened).
BUBBLES_PUSH_SWEEP=1
