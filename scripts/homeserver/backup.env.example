# Bubbles home server: nightly Supabase backup settings. Lives at /etc/bubbles-home/backup.env (root only, mode 600).
# Nothing is backed up until BOTH lines below are filled in.

# Supabase dashboard > Connect > "Session pooler" connection string (works over IPv4). Use the database password; if it has
# symbols, URL-encode them (@ -> %40, # -> %23, % -> %25). Example shape:
# SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# The PUBLIC half of an age key (starts with "age1..."). Make the key pair on your own PC, NOT on this laptop:
#   age-keygen -o bubbles-backup-key.txt
# Keep bubbles-backup-key.txt somewhere safe (password manager, USB drive). This laptop only ever holds encrypted backups.
AGE_RECIPIENT=

# How many days of nightly backups to keep.
KEEP_DAYS=14
