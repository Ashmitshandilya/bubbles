[Unit]
Description=Bubbles: encrypted nightly copy of the Supabase database
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bubblesbackup
Group=bubblesbackup
EnvironmentFile=/etc/bubbles-home/backup.env
Environment=PG_BIN=/usr/lib/postgresql/__PG_MAJOR__/bin
ExecStart=/usr/local/sbin/bubbles-backup
Nice=10
IOSchedulingClass=idle
# Hardening: it only needs the network and its own backup folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/bubbles
